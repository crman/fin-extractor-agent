# ==============================================================================
# Azure AI Foundry Configuration
# ==============================================================================
# The endpoint for your Azure AI Foundry project:
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-project.services.ai.azure.com

# The model deployment name inside your Foundry project (e.g. gpt-4o):
FOUNDRY_MODEL=gpt-4o

# Authentication: Run `az login` to authenticate with your Azure account.

# ==============================================================================
# Application Settings
# ==============================================================================
LOG_LEVEL=INFO

# ==============================================================================
# Observability & Tracing (OpenTelemetry -> Azure AI Foundry)
# ==============================================================================
# OPTIONAL: Azure AI Foundry automatically creates and attaches an Application
# Insights instance to your project. When this variable is omitted or left blank,
# the application automatically auto-discovers it via FOUNDRY_PROJECT_ENDPOINT.
# Uncomment only if you want to explicitly override the target Application Insights instance:
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Feature flag: Toggle GenAI OpenTelemetry distributed tracing (default: true)
ENABLE_GENAI_TRACING=true

# Privacy toggle: Set to false if you wish to redact full prompt/response contents from traces (default: true)
CAPTURE_MESSAGE_CONTENT=true

# ==============================================================================
# Guardrails & Content Safety (Prompt Shields)
# ==============================================================================
# Feature flag: Toggle Prompt Shield indirect document injection detection (default: true)
ENABLE_PROMPT_SHIELD=true

# OPTIONAL: Content Safety endpoint. If omitted or blank, auto-derived from
# FOUNDRY_PROJECT_ENDPOINT (e.g. https://<your-hub-resource>.services.ai.azure.com):
# CONTENT_SAFETY_ENDPOINT=https://<your-hub-resource>.cognitiveservices.azure.com

# OPTIONAL: Content Safety REST API version (default: 2024-09-01):
# CONTENT_SAFETY_API_VERSION=2024-09-01

# ==============================================================================
# Agent Skills (Progressive-Disclosure Skills)
# ==============================================================================
# Feature flag: Toggle Microsoft Agent Framework skills integration (default: true)
ENABLE_SKILLS=true

# OPTIONAL: Custom directory for skills (default: src/fin_extractor/skills)
# SKILLS_DIR=src/fin_extractor/skills


