# ==============================================================================
# Azure AI Foundry Configuration
# ==============================================================================
# The endpoint for your Azure AI Foundry project:
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-project.services.ai.azure.com

# The model deployment name inside your Foundry project (e.g. gpt-4o):
FOUNDRY_MODEL=gpt-4o

# Authentication: Run `az login` to authenticate with your Azure account.

# ==============================================================================
# Application Settings
# ==============================================================================
LOG_LEVEL=INFO
